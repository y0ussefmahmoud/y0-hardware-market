# ==========================================
# Dependencies (Must be installed on server)
# ==========================================
/node_modules
/.pnpm-store
/.yarn/*
!/.yarn/patches
!/.yarn/plugins
!/.yarn/releases

# ==========================================
# Next.js Build Outputs & Caches
# ==========================================
/.next/
/out/
/build/
/dist/

# Heavy Cache Purging (Saves Disk Space & Bandwidth)
*.tsbuildinfo
*.next
.cache/
next-env.d.ts

# ==========================================
# Logs & Process Manager Files
# ==========================================
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*
pm2.log
pm2-error.log

# ==========================================
# Environment Variables & Secrets
# ==========================================
.env
.env*.local
.env.production
.env.development
!.env.example

# ==========================================
# IDE & System Files
# ==========================================
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
*.pem

# ==========================================
# Testing & Coverage
# ==========================================
/coverage/
/.nyc_output/

# ==========================================
# Deployment Archives & Misc
# ==========================================
*.zip
Hostinger
.vercel
