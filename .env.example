# Database Configuration (Hostinger MySQL)
DB_HOST=localhost
DB_USER=your_hostinger_db_user
DB_PASSWORD=your_hostinger_db_password
DB_NAME=your_hostinger_db_name
DB_PORT=3306

# NextAuth Configuration (Update with your domain)
NEXTAUTH_URL=https://yourdomain.com
NEXTAUTH_SECRET=your_super_secret_nextauth_key_change_this_in_production

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# API & ISR Revalidation Configuration
NEXT_PUBLIC_API_URL=https://yourdomain.com
REVALIDATION_SECRET=your_super_secret_revalidation_token_2026

# Node Environment
NODE_ENV=production
